# Usługa systemd dla VPS (np. Oracle Always Free).
# Instalacja: sudo cp sportowa-szkola.service /etc/systemd/system/
#             sudo systemctl daemon-reload && sudo systemctl enable --now sportowa-szkola
[Unit]
Description=Sportowa Szkola (Flask/gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/sportowa-szkola
Environment="SECRET_KEY=TUTAJ-WKLEJ-DLUGI-LOSOWY-SEKRET"
Environment="PATH=/opt/sportowa-szkola/venv/bin:/usr/bin:/bin"
ExecStart=/opt/sportowa-szkola/venv/bin/gunicorn -w 3 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
